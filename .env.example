# ===== 服务端口（本地开发默认 3000；部署到 Render 时平台会自动给 PORT，不用改）=====
PORT=3000

# ===== JWT 密钥（随便填一长串英文+数字，越乱越好，不要泄露给别人）=====
JWT_SECRET=change-this-to-a-long-random-string-2026

# ===== 发邮件的邮箱（推荐用 QQ 邮箱，免费且国内 100% 能收到）=====
# 1. 登录 mail.qq.com → 设置 → 账号 → 开启 SMTP/IMAP 服务
# 2. 按提示发短信，得到一串“授权码”（16位，不是邮箱密码！）
# 用 163 邮箱同理：设置 → POP3/SMTP/IMAP → 开启，得到授权密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=你的16位授权码
# 收件人看到的发件人名称
MAIL_FROM_NAME=扩列

# ===== 数据库文件路径（本地开发用这个，部署 Render 时按教程改）=====
DB_PATH=./data/app.db
